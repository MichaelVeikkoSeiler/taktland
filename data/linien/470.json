  {
   "thema": "Linie einer anderen Bahn",
   "grund": "Diese Linie fehlt in den Daten der SBB. Sie stammt aus dem Schienennetz des Bundesamts für Verkehr (BAV). Tunnel, Brücken und Bahnübergänge sind nur in den Daten der SBB erfasst.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Länge der Linie",
   "grund": "Die Länge der Linie steht nicht in den offenen Daten. Erfasst ist der Kilometer jedes Betriebspunkts, ein Standort auf der Linie.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Anfang und Ende",
   "grund": "Welcher Betriebspunkt Anfang und welcher Ende der Linie ist, nennt das Schienennetz nicht. Aufgeführt sind die Betriebspunkte mit dem kleinsten und dem grössten Kilometer.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Baujahr der Linie",
   "grund": "Wann die Linie gebaut oder eröffnet wurde, steht nicht in den offenen Daten. Ein Jahr ist nur für Tunnel erfasst: das Jahr der ersten Inbetriebnahme.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Stand des Schienennetzes",
   "grund": "Das Schienennetz des BAV trägt den Stand vom 2021-07-06. Was sich seither geändert hat, ist darin nicht erfasst.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Weitere Betriebspunkte",
   "grund": "Aufgeführt sind die 16 Bahnhöfe, die Taktland kennt. Das Schienennetz führt für diese Linie 25 Betriebspunkte. Die übrigen sind in Taktland nicht als Bahnhof geführt.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Züge auf der Linie",
   "grund": "Welche Züge auf dieser Linie fahren, ist nicht Teil dieser Daten. Eine Linie ist hier eine Strecke der Infrastruktur, keine Zuglinie wie eine S-Bahn.",
   "quelle": "schienennetz"
  }
