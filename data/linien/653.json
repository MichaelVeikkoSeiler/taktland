 "luecken": [
  {
   "thema": "Länge der Linie",
   "grund": "Die Länge der Linie steht nicht in den offenen Daten. Erfasst sind der Anfangs- und der End-Kilometer ihrer Kilometrierung.",
   "quelle": "linie"
  },
  {
   "thema": "Baujahr der Linie",
   "grund": "Wann die Linie gebaut oder eröffnet wurde, steht nicht in den offenen Daten. Ein Jahr ist nur für Tunnel erfasst: das Jahr der ersten Inbetriebnahme.",
   "quelle": "linie, tunnel"
  },
  {
   "thema": "Stand des Schienennetzes",
   "grund": "Das Schienennetz des BAV trägt den Stand vom 2021-07-06. Was sich seither geändert hat, ist darin nicht erfasst.",
   "quelle": "schienennetz"
  },
  {
   "thema": "Weitere Betriebspunkte",
   "grund": "Aufgeführt sind die 10 Bahnhöfe, die Taktland kennt. Die Liste der Betriebspunkte führt für diese Linie 18 Einträge. Die übrigen sind in Taktland nicht als Bahnhof geführt.",
   "quelle": "linie-mit-betriebspunkten"
  },
  {
   "thema": "Länge und Baujahr der Brücken",
   "grund": "Länge und Baujahr der Brücken stehen nicht in den offenen Daten. Erfasst sind Name, Kilometer, Kanton und die Zahl der Baueinheiten.",
   "quelle": "brucken"
  },
  {
   "thema": "Namen der Brücken",
   "grund": "Die Namen stehen wie in der Quelle, oft mit Abkürzungen wie «PI», «PU» oder «WU». Was diese bedeuten, erklärt die Quelle nicht.",
   "quelle": "brucken"
  },
  {
   "thema": "Stand der Brückendaten",
   "grund": "Die Beschreibung der Quelle nennt als letzte Aktualisierung auf Deutsch «Januar 24», auf Englisch «Jan 2026».",
   "quelle": "brucken"
  },
  {
   "thema": "Einträge zu den Bahnübergängen",
   "grund": "Namen und Sicherungsart stehen wie in der Quelle, auch abgekürzt, etwa «VRA» oder «Bedarfsschrankenanl». Einige Felder beschreibt die Quelle mit Texten aus anderen Datensätzen, etwa den Namen als «Bezeichnung der Treppe/Rampe». Verwendet sind nur die Sicherungsart und die Zahl der gekreuzten Gleise.",
   "quelle": "bahnubergang"
  },
